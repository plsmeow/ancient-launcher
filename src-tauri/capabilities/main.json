{
    "identifier": "main-capability",
    "description": "Capability for the main window",
    "windows": ["main"],
    "permissions": [
        "core:path:default",
        "core:event:default",
        "core:window:default",
        "core:app:default",
        "core:resources:default",
        "core:window:allow-set-title",
        "core:window:allow-start-dragging",
        "core:window:allow-minimize",
        "dialog:allow-open",
        "opener:default",
        "process:allow-exit"
    ]
}
